});

const accountSchema = new mongoose.Schema({
  name: String,
  balance: Number,
});

const Account = mongoose.model('Account', accountSchema);

const transferFunds = async (fromAccountId, toAccountId, amount) => {
  const session = await mongoose.startSession();
  session.startTransaction();

  try {
    // Deduct amount from the sender's account
    const fromAccount = await Account.findById(fromAccountId).session(session);
    if (fromAccount.balance < amount) {
      throw new Error('Insufficient funds');
    }
    fromAccount.balance -= amount;
    await fromAccount.save();

    // Add amount to the recipient's account
    const toAccount = await Account.findById(toAccountId).session(session);
    toAccount.balance += amount;
    await toAccount.save();

    // Commit the transaction
    await session.commitTransaction();
    console.log('Transaction successful');
  } catch (error) {
    // Rollback the transaction in case of an error
    await session.abortTransaction();
    console.error('Transaction failed:', error.message);
  } finally {
    session.endSession();
  }
};

// Example usage
transferFunds('accountId1', 'accountId2', 100);


Use Case for Session Management :
---------------------------------------- >

Transaction Context: The session acts as the container for the transaction. It ensures that all operations (e.g., updating the sender's and recipient's balances) are executed as part of the same transactional unit.

Atomicity: By binding database operations to the session, you ensure that the changes are either fully applied (committed) or completely undone (rolled back) in case of an error.

Isolation: The session keeps the transaction isolated from other operations in the database. This means that other database clients won't see intermediate states of the data during the transaction.

Error Handling and Rollback: If any operation within the session fails (e.g., insufficient funds in the sender's account), the session allows the transaction to be aborted. This rolls back all changes to maintain data integrity.




